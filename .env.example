# ── Credenciales (NUNCA se versionan; .env está en .gitignore) ───────────────
GEMINI_API_KEYS=key1,key2,key3
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/
LANGCHAIN_API_KEY=lsv2_...

# ── Base de datos ────────────────────────────────────────────────────────────
MONGODB_DB_NAME=hazmat_gre
MONGODB_COLLECTION_NAME=gre_chunks_v5
VECTOR_INDEX_NAME=vector_index

# ── Modelos ──────────────────────────────────────────────────────────────────
LLM_MODEL=gemini-3.6-flash
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
LLM_TIMEOUT_S=30
MODEL_COOLDOWN_S=120
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── Recuperación ─────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.35

# ── Seguridad ────────────────────────────────────────────────────────────────
AUTH_ENABLED=true
GUARDRAIL_LLM=true
MAX_QUERY_CHARS=2000
RATE_LIMIT_PER_MIN=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Cambiar en producción: sal para seudonimizar usuarios en la telemetría
TELEMETRY_SALT=cambia-esta-sal
# Obligatoria en producción: clave HMAC de los códigos de verificación por correo (32+ caracteres
# aleatorios, p. ej. `python -c "import secrets; print(secrets.token_urlsafe(32))"`). Si falta, se usa
# una clave aleatoria por proceso y los códigos dejan de valer al reiniciar o entre réplicas.
OTP_SECRET=cambia-esta-clave

# ── Observabilidad (LangSmith) y retención de datos ──────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=Bomberos-HAZMAT-RAG
SESSION_TTL_DAYS=90
TELEMETRY_TTL_DAYS=180
LOG_LEVEL=INFO

# ── Correo (Gmail SMTP con "contraseña de aplicación") ───────────────────────
# Crear en: Cuenta de Google → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# SMTP_USER es la DIRECCIÓN de correo completa; SMTP_PASSWORD, la contraseña de aplicación (16 letras).
# Probar con: python -m src.notify.smtp_check   (y --send-to tu@correo para un envío real)
SMTP_USER=tu.cuenta@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM=tu.cuenta@gmail.com
ADMIN_EMAILS=admin1@dominio.cl,admin2@dominio.cl
MAIL_MAX_PER_HOUR=5
APP_URL=http://localhost:8501
# true en producción. false SOLO en desarrollo: las cuentas nuevas quedan activas sin código.
# Con true y el correo mal configurado, el registro se bloquea con un aviso (no crea cuentas).
EMAIL_VERIFICATION_REQUIRED=true

# ── Mapa, visión y alertas ───────────────────────────────────────────────────
DAY_START=7
DAY_END=19
GEOCODER_COUNTRY=cl
# Mapas actualizados (opcionales; sin claves se usa OpenStreetMap):
# - Esri: cuenta gratuita sin tarjeta en developers.arcgis.com → API key con "Basemap styles" y
#   "Static basemap tiles". Restringe la clave por dominio (Referrers).
# - Google Map Tiles API: requiere cuenta de facturación; restringe la clave a Map Tiles API y a tu dominio.
ESRI_API_KEY=
GOOGLE_MAPS_API_KEY=
VISION_MODEL=gemini-3.5-flash-lite
MAX_IMAGE_MB=5
ALERT_P95_S=20
ALERT_ERROR_RATE=0.05
ALERT_BLOCKED_RATE=0.30
ALERT_WINDOW_MIN=30
ALERT_COOLDOWN_H=6
