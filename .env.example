# ── Credenciales (NUNCA se versionan; .env está en .gitignore) ───────────────
GEMINI_API_KEYS=key1,key2,key3
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/
LANGCHAIN_API_KEY=lsv2_...

# ── Base de datos ────────────────────────────────────────────────────────────
MONGODB_DB_NAME=hazmat_gre
MONGODB_COLLECTION_NAME=gre_chunks_v5
VECTOR_INDEX_NAME=vector_index

# ── Modelos ──────────────────────────────────────────────────────────────────
LLM_MODEL=gemini-3.6-flash
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
LLM_TIMEOUT_S=30
MODEL_COOLDOWN_S=120
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── Recuperación ─────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.35

# ── Seguridad ────────────────────────────────────────────────────────────────
AUTH_ENABLED=true
GUARDRAIL_LLM=true
MAX_QUERY_CHARS=2000
RATE_LIMIT_PER_MIN=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Cambiar en producción: sal para seudonimizar usuarios en la telemetría
TELEMETRY_SALT=cambia-esta-sal

# ── Observabilidad (LangSmith) y retención de datos ──────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=Bomberos-HAZMAT-RAG
SESSION_TTL_DAYS=90
TELEMETRY_TTL_DAYS=180
LOG_LEVEL=INFO
